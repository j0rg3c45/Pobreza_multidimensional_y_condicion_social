   "source": [
    "# @title 14. Mapa temático — IPM (Accesibilidad y Estándar Cali)\n",
    "# Priorizar columna 'ipm' y filtrar códigos administrativos\n",
    "target_col = 'ipm' if 'ipm' in gdf_ipm.columns else None\n",
    "if not target_col:\n",
    "    num_cols = [c for c in gdf_ipm.columns if gdf_ipm[c].dtype in ['float64', 'int64'] and not c.startswith('cod_') and c.lower() not in ['objectid', 'fid', 'id', 'shape_leng', 'shape_area', 'shape_len', 'shape_le', 'oid_']]\n",
    "    target_col = num_cols[0] if num_cols else None\n",
    "\n",
    "if target_col:\n",
    "    fig, ax = plt.subplots(1, 1, figsize=(14, 12))\n",
    "    # Estándar: viridis (colorblind friendly), fondo de contexto gris claro para 'Efecto Atlas'\n",
    "    gdf_ipm.plot(ax=ax, color='#f2f2f2', edgecolor='#cccccc', linewidth=0.1)\n",
    "    gdf_ipm.plot(column=target_col, ax=ax, legend=True,\n",
    "                 cmap='viridis', edgecolor='white', linewidth=0.2,\n",
    "                 legend_kwds={'label': f'Incidencia {target_col.upper()} (%)', 'shrink': 0.6, \n",
    "                              'format': '%.1f'})  # Estándar: 1 decimal\n",
    "    ax.set_title(f'Mapa de Pobreza Multidimensional (IPM) — Cali', fontsize=15, fontweight='bold')\n",
    "    ax.set_axis_off()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print('No se encontró columna de IPM para mapear')\n"
   ]
